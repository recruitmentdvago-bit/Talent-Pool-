# Copy these into Railway -> your service -> Variables  (never commit a real .env)

# --- required -------------------------------------------------------------
ADMIN_PASSWORD=choose-a-long-password        # the first admin login (username: admin). Without it a random one is printed in the deploy log.

# --- the AI agent (pick one; keys stay here, never in the app or the repo) ---
GROQ_API_KEY=                                # free tier: console.groq.com -> API Keys
# ANTHROPIC_API_KEY=                         # optional alternative (paid)

# --- LinkedIn collector on your PC (optional) -------------------------------
INGEST_TOKEN=                                # any long random string; the same value goes on your PC. Empty = collector access is off.

# --- usually automatic -------------------------------------------------------
# SOURCER_ENV=production                     # set by the Dockerfile
# SOURCER_DATA_DIR=/data                     # set by the Dockerfile; mount the Railway Volume at /data
# SOURCER_ALLOWED_HOSTS=talent.yourcompany.com   # only if you add a custom domain (the *.up.railway.app one is picked up by itself)
# SOURCER_SECRET_KEY=                        # optional; otherwise one is generated and kept on the volume
# RESET_ADMIN_PASSWORD=                      # locked out? set this, redeploy once, then DELETE it
